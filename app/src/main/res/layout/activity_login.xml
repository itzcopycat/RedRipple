<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/redripple_background"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/screen_top_padding"
        android:paddingBottom="@dimen/screen_bottom_padding">

        <!-- ===================== Brand Header ===================== -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_redripple_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.RedRipple.Brand"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:text="@string/app_tagline"
            android:textAppearance="@style/TextAppearance.RedRipple.Tagline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName" />

        <!-- ===================== Welcome Text ===================== -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/login_welcome_title"
            android:textAppearance="@style/TextAppearance.RedRipple.Headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTagline" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:text="@string/login_welcome_subtitle"
            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

        <!-- ===================== Form Card ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginForm"
            style="@style/Widget.RedRipple.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_lg">

                <!-- Email / Phone -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmailOrPhone"
                    style="@style/Widget.RedRipple.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_email_or_phone"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:startIconContentDescription="@string/cd_email_icon"
                    app:startIconDrawable="@drawable/ic_email">

                    <!-- No android:hint here: the TextInputLayout label is the only hint -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmailOrPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.RedRipple.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:hint="@string/label_password"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconContentDescription="@string/cd_toggle_password"
                    app:endIconMode="password_toggle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilEmailOrPhone"
                    app:startIconContentDescription="@string/cd_lock_icon"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Remember me + Forgot password -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbRememberMe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/remember_me"
                    android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                    app:layout_constraintEnd_toStartOf="@id/tvForgotPassword"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilPassword" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_xxs"
                    android:text="@string/forgot_password"
                    android:textAppearance="@style/TextAppearance.RedRipple.Link"
                    app:layout_constraintBottom_toBottomOf="@id/cbRememberMe"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cbRememberMe" />

                <!-- Login Button (with inline loading state) -->
                <FrameLayout
                    android:id="@+id/loginButtonContainer"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cbRememberMe">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.RedRipple.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/btn_login" />

                    <ProgressBar
                        android:id="@+id/progressLogin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/redripple_on_primary"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/dividerStart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/divider_thickness"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@color/redripple_divider"
                    app:layout_constraintEnd_toStartOf="@id/tvOr"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/loginButtonContainer" />

                <TextView
                    android:id="@+id/tvOr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:text="@string/divider_or"
                    android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                    android:textSize="@dimen/text_caption"
                    app:layout_constraintBottom_toBottomOf="@id/dividerStart"
                    app:layout_constraintEnd_toStartOf="@id/dividerEnd"
                    app:layout_constraintStart_toEndOf="@id/dividerStart"
                    app:layout_constraintTop_toTopOf="@id/dividerStart" />

                <View
                    android:id="@+id/dividerEnd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/divider_thickness"
                    android:background="@color/redripple_divider"
                    app:layout_constraintBottom_toBottomOf="@id/dividerStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvOr"
                    app:layout_constraintTop_toTopOf="@id/dividerStart" />

                <!-- Google Sign-In -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.RedRipple.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/social_button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/btn_continue_google"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_google_placeholder"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerStart" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== Signup Navigation ===================== -->
        <LinearLayout
            android:id="@+id/layoutSignupPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardLoginForm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_account_prompt"
                android:textAppearance="@style/TextAppearance.RedRipple.Subtitle" />

            <TextView
                android:id="@+id/tvGoToSignup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xxs"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_xxs"
                android:text="@string/signup_link"
                android:textAppearance="@style/TextAppearance.RedRipple.Link" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>