<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.RedRipple.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_md">

        <TextView
            android:id="@+id/tvItemBadge"
            android:layout_width="@dimen/home_badge_size"
            android:layout_height="@dimen/home_badge_size"
            android:background="@drawable/bg_blood_badge"
            android:gravity="center"
            android:text="A+"
            android:textColor="@color/redripple_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvItemHospital"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="City General Hospital"
            android:textColor="@color/redripple_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvItemBadge"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvItemMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="2 units needed • Patient: John Doe"
            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvItemBadge"
            app:layout_constraintTop_toBottomOf="@id/tvItemHospital" />

        <TextView
            android:id="@+id/tvItemTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="Contact: 9876543210"
            android:textColor="@color/redripple_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvItemBadge"
            app:layout_constraintTop_toBottomOf="@id/tvItemMeta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemRespond"
            style="@style/Widget.RedRipple.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/home_btn_respond"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvItemTime" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
