<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/redripple_background"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="@dimen/space_lg">

            <!-- ===================== Header ===================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/home_greeting"
                    android:textAppearance="@style/TextAppearance.RedRipple.Headline"
                    app:layout_constraintEnd_toStartOf="@id/btnNotifications"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvGreetingSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:text="@string/home_greeting_sub"
                    android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                    app:layout_constraintEnd_toStartOf="@id/btnNotifications"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNotifications"
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="@dimen/home_icon_button"
                    android:layout_height="@dimen/home_icon_button"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="22dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_notifications"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/redripple_primary" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===================== Hero Card ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                style="@style/Widget.RedRipple.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_gradient"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:id="@+id/imgHeroArt"
                        android:layout_width="@dimen/home_hero_art"
                        android:layout_height="@dimen/home_hero_art"
                        android:alpha="0.25"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_redripple_logo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHeroChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_hero_chip"
                        android:textColor="@color/redripple_on_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_hero_title"
                        android:textColor="@color/redripple_on_primary"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/imgHeroArt"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHeroChip" />

                    <TextView
                        android:id="@+id/tvHeroBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:alpha="0.9"
                        android:text="@string/home_hero_body"
                        android:textColor="@color/redripple_on_primary"
                        android:textSize="@dimen/text_body_small"
                        app:layout_constraintEnd_toStartOf="@id/imgHeroArt"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHeroTitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeroRequest"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="@string/home_btn_request_blood"
                        android:textAllCaps="false"
                        android:textColor="@color/redripple_primary"
                        app:backgroundTint="@color/redripple_on_primary"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:layout_constraintEnd_toStartOf="@id/btnHeroFind"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHeroBody" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeroFind"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="@string/home_btn_find_donors"
                        android:textAllCaps="false"
                        android:textColor="@color/redripple_on_primary"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:layout_constraintBaseline_toBaselineOf="@id/btnHeroRequest"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/btnHeroRequest"
                        app:strokeColor="@color/redripple_on_primary" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Stats Row ===================== -->
            <LinearLayout
                android:id="@+id/rowStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView
                            android:id="@+id/tvStatBloodGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_sample_blood_group"
                            android:textColor="@color/redripple_primary"
                            android:textSize="@dimen/text_headline"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_stat_blood_group"
                            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xxs"
                    android:layout_marginEnd="@dimen/space_xxs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView
                            android:id="@+id/tvStatDonations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_sample_donations"
                            android:textColor="@color/redripple_primary"
                            android:textSize="@dimen/text_headline"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_stat_donations"
                            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView
                            android:id="@+id/tvStatLives"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_sample_lives"
                            android:textColor="@color/redripple_primary"
                            android:textSize="@dimen/text_headline"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_stat_lives"
                            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===================== Quick Actions ===================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/home_section_quick_actions"
                android:textAppearance="@style/TextAppearance.RedRipple.Headline"
                android:textSize="@dimen/text_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDonate"
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/home_action_icon"
                            android:layout_height="@dimen/home_action_icon"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@string/cd_action_icon"
                            android:padding="@dimen/space_sm"
                            android:src="@drawable/ic_action_donate"
                            app:tint="@color/redripple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/home_action_donate"
                            android:textColor="@color/redripple_text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_donate_sub"
                            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRequest"
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/home_action_icon"
                            android:layout_height="@dimen/home_action_icon"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@string/cd_action_icon"
                            android:padding="@dimen/space_sm"
                            android:src="@drawable/ic_action_request"
                            app:tint="@color/redripple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/home_action_request"
                            android:textColor="@color/redripple_text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_request_sub"
                            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFindDonors"
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/home_action_icon"
                            android:layout_height="@dimen/home_action_icon"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@string/cd_action_icon"
                            android:padding="@dimen/space_sm"
                            android:src="@drawable/ic_action_find"
                            app:tint="@color/redripple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/home_action_find"
                            android:textColor="@color/redripple_text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_find_sub"
                            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBloodBanks"
                    style="@style/Widget.RedRipple.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/home_action_icon"
                            android:layout_height="@dimen/home_action_icon"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@string/cd_action_icon"
                            android:padding="@dimen/space_sm"
                            android:src="@drawable/ic_action_bank"
                            app:tint="@color/redripple_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/home_action_banks"
                            android:textColor="@color/redripple_text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_action_banks_sub"
                            android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===================== Urgent Requests ===================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <TextView
                    android:id="@+id/tvUrgentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_section_urgent"
                    android:textAppearance="@style/TextAppearance.RedRipple.Headline"
                    android:textSize="@dimen/text_title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_xxs"
                    android:text="@string/home_see_all"
                    android:textAppearance="@style/TextAppearance.RedRipple.Link"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Sample request #1 (replace with a RecyclerView once real data is wired) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRequest1"
                style="@style/Widget.RedRipple.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:id="@+id/tvBadge1"
                        android:layout_width="@dimen/home_badge_size"
                        android:layout_height="@dimen/home_badge_size"
                        android:background="@drawable/bg_blood_badge"
                        android:gravity="center"
                        android:text="@string/home_sample_group_1"
                        android:textColor="@color/redripple_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHospital1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/home_sample_hospital_1"
                        android:textColor="@color/redripple_text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvBadge1"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvMeta1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/home_sample_meta_1"
                        android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                        android:textSize="@dimen/text_body_small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvBadge1"
                        app:layout_constraintTop_toBottomOf="@id/tvHospital1" />

                    <TextView
                        android:id="@+id/tvTime1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/home_sample_time_1"
                        android:textColor="@color/redripple_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvBadge1"
                        app:layout_constraintTop_toBottomOf="@id/tvMeta1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRespond1"
                        style="@style/Widget.RedRipple.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:text="@string/home_btn_respond"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_body_small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTime1" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sample request #2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRequest2"
                style="@style/Widget.RedRipple.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:id="@+id/tvBadge2"
                        android:layout_width="@dimen/home_badge_size"
                        android:layout_height="@dimen/home_badge_size"
                        android:background="@drawable/bg_blood_badge"
                        android:gravity="center"
                        android:text="@string/home_sample_group_2"
                        android:textColor="@color/redripple_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHospital2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/home_sample_hospital_2"
                        android:textColor="@color/redripple_text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvBadge2"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvMeta2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/home_sample_meta_2"
                        android:textAppearance="@style/TextAppearance.RedRipple.Subtitle"
                        android:textSize="@dimen/text_body_small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvBadge2"
                        app:layout_constraintTop_toBottomOf="@id/tvHospital2" />

                    <TextView
                        android:id="@+id/tvTime2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/home_sample_time_2"
                        android:textColor="@color/redripple_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvBadge2"
                        app:layout_constraintTop_toBottomOf="@id/tvMeta2" />

